---
import { href } from '~/utils/site';

const icons = {
	cards: 'M4 6.5h10a1.5 1.5 0 0 1 1.5 1.5v8A1.5 1.5 0 0 1 14 17.5H4A1.5 1.5 0 0 1 2.5 16V8A1.5 1.5 0 0 1 4 6.5ZM6 3.5h10A1.5 1.5 0 0 1 17.5 5v8',
	calculator: 'M5 2.5h10A1.5 1.5 0 0 1 16.5 4v12a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 16V4A1.5 1.5 0 0 1 5 2.5ZM6.5 5.5h7v3h-7zM7 12h.01M10 12h.01M13 12h.01M7 15h.01M10 15h.01M13 15h.01',
	pulse: 'M2.5 10h3l2-5 3 10 2-5h5',
	clock: 'M10 2.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15ZM10 6v4l2.5 2',
	book: 'M3.5 4.5c2.5-1 4.5-1 6.5.5 2-1.5 4-1.5 6.5-.5v11c-2.5-1-4.5-1-6.5.5-2-1.5-4-1.5-6.5-.5zM10 5v11',
	map: 'M2.5 5.5l5-2 5 2 5-2v11l-5 2-5-2-5 2zM7.5 3.5v11M12.5 5.5v11',
	chat: 'M3.5 4.5h13v9h-7l-4 3v-3h-2z',
} as const;

export type TileIcon = keyof typeof icons;

interface Props {
	items: { title: string; description: string; href: string; icon?: TileIcon }[];
}

const { items } = Astro.props;
---

<ul class="sdp-tiles not-content">
	{
		items.map((item) => (
			<li>
				<a href={href(item.href)}>
					{item.icon && (
						<span class="icon" aria-hidden="true">
							<svg viewBox="0 0 20 20">
								<path
									d={icons[item.icon]}
									fill="none"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</span>
					)}
					<span class="title">{item.title}</span>
					<span class="desc">{item.description}</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	.sdp-tiles {
		list-style: none;
		margin: 1.5rem 0;
		padding: 0;
		display: grid;
		gap: 0.8rem;
		grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
	}

	a {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		height: 100%;
		padding: 1.05rem 1.1rem;
		border-radius: var(--sdp-radius);
		border: 1px solid var(--sdp-border);
		background: var(--sdp-surface);
		box-shadow: var(--sdp-shadow);
		text-decoration: none;
		transition:
			border-color 0.18s ease,
			transform 0.18s ease;
	}

	a:hover {
		border-color: var(--sl-color-accent);
		transform: translateY(-2px);
	}

	.icon {
		display: grid;
		place-items: center;
		width: 2.3rem;
		height: 2.3rem;
		border-radius: 10px;
		color: var(--sl-color-accent-high);
		background: var(--sl-color-accent-low);
	}

	:global(:root[data-theme='light']) .icon {
		color: var(--sl-color-accent);
	}

	.icon svg {
		width: 1.25rem;
		height: 1.25rem;
	}

	.title {
		font-weight: 750;
		color: var(--sl-color-white);
	}

	.desc {
		font-size: var(--sl-text-sm);
		line-height: 1.65;
		color: var(--sdp-muted);
		word-break: keep-all;
	}
</style>
