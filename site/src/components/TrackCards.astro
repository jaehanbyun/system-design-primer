---
import { allTaskIds, planOrder, plans } from '~/data/plans';
import { href } from '~/utils/site';

const depth = { short: 1, medium: 2, long: 3 } as const;
---

<div class="sdp-tracks not-content">
	{
		planOrder.map((id) => {
			const plan = plans[id];
			const ids = allTaskIds(id);
			return (
				<a class="track sdp-card" data-plan={id} href={href(`guide/${id}`)} data-sdp-plan-ids={ids.join(' ')}>
					<div class="top">
						<span class="sdp-chip" data-plan={id}>
							{plan.label}
						</span>
						<span class="duration">{plan.duration}</span>
					</div>
					<h3>{plan.focus}</h3>
					<p>{plan.summary}</p>
					<dl class="facets">
						<div>
							<dt>깊이</dt>
							<dd class="dots" aria-label={`3단계 중 ${depth[id]}단계`}>
								{[1, 2, 3].map((n) => (
									<i class:list={{ on: n <= depth[id] }} />
								))}
							</dd>
						</div>
						<div>
							<dt>문제 풀이</dt>
							<dd>
								{plan.practiceLabel} <span class="en">({plan.practice})</span>
							</dd>
						</div>
						<div>
							<dt>체크리스트</dt>
							<dd>{ids.length}개</dd>
						</div>
					</dl>
					<div class="progress-row">
						<div class="sdp-progress" data-bar />
						<span class="count" data-count>
							0 / {ids.length}
						</span>
					</div>
					<span class="cta">
						{plan.title} 보기
						<svg viewBox="0 0 16 16" aria-hidden="true">
							<path
								d="M3 8h10M9 4l4 4-4 4"
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</span>
				</a>
			);
		})
	}
</div>

<script>
	import { doneIds, subscribe } from '~/scripts/progress';

	const cards = [...document.querySelectorAll<HTMLElement>('[data-sdp-plan-ids]')];
	subscribe(() => {
		const done = doneIds();
		for (const card of cards) {
			const ids = card.dataset.sdpPlanIds!.split(' ');
			const count = ids.filter((id) => done.has(id)).length;
			const pct = Math.round((count / ids.length) * 100);
			card.querySelector<HTMLElement>('[data-bar]')?.style.setProperty('--value', `${pct}%`);
			const label = card.querySelector('[data-count]');
			if (label) label.textContent = count > 0 ? `${count} / ${ids.length} · ${pct}%` : `0 / ${ids.length}`;
			card.toggleAttribute('data-started', count > 0);
		}
	});
</script>

<style>
	.sdp-tracks {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(15.5rem, 1fr));
		margin-block: 1.5rem;
	}

	.track {
		--tone: var(--sdp-medium);
		--sdp-bar: var(--tone);
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.25rem 1.25rem 1.1rem;
		text-decoration: none;
		color: var(--sl-color-gray-2);
		overflow: hidden;
		transition:
			transform 0.18s ease,
			border-color 0.18s ease;
	}

	.track::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		height: 3px;
		background: var(--tone);
	}

	.track[data-plan='short'] {
		--tone: var(--sdp-short);
	}

	.track[data-plan='long'] {
		--tone: var(--sdp-long);
	}

	.track:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--tone) 60%, var(--sdp-border));
	}

	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.duration {
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sdp-muted);
	}

	h3 {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 750;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
	}

	p {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.7;
		word-break: keep-all;
		flex: 1;
	}

	.facets {
		display: grid;
		grid-template-columns: repeat(3, auto);
		justify-content: space-between;
		gap: 0.5rem;
		margin: 0;
		padding: 0.75rem 0 0;
		border-top: 1px dashed var(--sdp-border);
	}

	.facets div {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.facets dt {
		font-size: var(--sl-text-2xs);
		color: var(--sdp-muted);
	}

	.facets dd {
		margin: 0;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		color: var(--sl-color-white);
	}

	.en {
		font-weight: 500;
		color: var(--sdp-muted);
		font-size: var(--sl-text-2xs);
	}

	.dots {
		display: flex;
		gap: 0.25rem;
		align-items: center;
		height: 1.4rem;
	}

	.dots i {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 3px;
		background: var(--sdp-surface-2);
		box-shadow: inset 0 0 0 1px var(--sdp-border);
	}

	.dots i.on {
		background: var(--tone);
		box-shadow: none;
	}

	.progress-row {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.progress-row .sdp-progress {
		flex: 1;
	}

	.count {
		font-size: var(--sl-text-2xs);
		font-variant-numeric: tabular-nums;
		color: var(--sdp-muted);
		white-space: nowrap;
	}

	.track[data-started] .count {
		color: var(--tone);
		font-weight: 700;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		color: var(--tone);
	}

	.cta svg {
		width: 0.95rem;
		height: 0.95rem;
		transition: transform 0.18s ease;
	}

	.track:hover .cta svg {
		transform: translateX(3px);
	}
</style>
