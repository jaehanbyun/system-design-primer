---
import { plans, type PlanId } from '~/data/plans';
import { resolvePlan } from '~/utils/plan-tasks';

interface Props {
	plan: PlanId;
}

const { plan } = Astro.props;
const resolved = await resolvePlan(plan);
const seen = new Set<string>();
const tasks = resolved
	.flat()
	.filter((task) => (seen.has(task.id) ? false : (seen.add(task.id), true)))
	.map(({ id, title, url }) => ({ id, title, url }));
const info = plans[plan];
---

<section class="sdp-plan-progress sdp-card not-content" data-plan={plan} data-tasks={JSON.stringify(tasks)}>
	<div class="ring" aria-hidden="true">
		<svg viewBox="0 0 64 64">
			<circle cx="32" cy="32" r="27" class="track"></circle>
			<circle cx="32" cy="32" r="27" class="value" data-ring pathLength="100" stroke-dasharray="0 100"></circle>
		</svg>
		<span data-percent>0%</span>
	</div>
	<div class="info">
		<p class="label">
			<span class="sdp-chip" data-plan={plan}>{info.label}</span>
			<span>{info.duration} · {info.focus} · 문제 풀이 {info.practiceLabel}</span>
		</p>
		<p class="status" data-status>아직 시작하지 않았어요. 첫 항목부터 차근차근 시작해 보세요.</p>
		<p class="next" data-next hidden>
			이어서 공부하기 → <a data-next-link href="#"></a>
		</p>
	</div>
	<button type="button" class="reset" data-reset>초기화</button>
</section>

<script>
	import { doneIds, resetAll, subscribe } from '~/scripts/progress';

	for (const root of document.querySelectorAll<HTMLElement>('.sdp-plan-progress')) {
		const tasks: { id: string; title: string; url?: string }[] = JSON.parse(root.dataset.tasks!);
		const ring = root.querySelector<SVGCircleElement>('[data-ring]')!;
		const percent = root.querySelector('[data-percent]')!;
		const status = root.querySelector('[data-status]')!;
		const next = root.querySelector<HTMLElement>('[data-next]')!;
		const nextLink = root.querySelector<HTMLAnchorElement>('[data-next-link]')!;

		subscribe(() => {
			const done = doneIds();
			const count = tasks.filter((task) => done.has(task.id)).length;
			const pct = Math.round((count / tasks.length) * 100);
			ring.setAttribute('stroke-dasharray', `${pct} 100`);
			percent.textContent = `${pct}%`;
			status.textContent =
				count === 0
					? `아직 시작하지 않았어요. 전체 ${tasks.length}개 항목 중 첫 항목부터 시작해 보세요.`
					: count === tasks.length
						? `${tasks.length}개 항목을 모두 마쳤어요. 플래시카드로 복습하며 감을 유지하세요.`
						: `${tasks.length}개 중 ${count}개 완료했어요.`;
			const upcoming = tasks.find((task) => !done.has(task.id) && task.url);
			next.hidden = !upcoming || count === tasks.length;
			if (upcoming) {
				nextLink.textContent = upcoming.title;
				nextLink.href = upcoming.url!;
			}
			root.toggleAttribute('data-complete', count === tasks.length);
		});

		root.querySelector('[data-reset]')?.addEventListener('click', () => {
			if (confirm('이 플랜의 체크 표시를 모두 지울까요?\n같은 페이지를 포함하는 다른 플랜에도 반영됩니다.')) {
				resetAll(tasks.map((task) => task.id));
			}
		});
	}
</script>

<style>
	.sdp-plan-progress {
		--tone: var(--sdp-medium);
		display: flex;
		align-items: center;
		gap: 1.1rem;
		padding: 1rem 1.2rem;
		margin-block: 1.5rem;
	}

	.sdp-plan-progress[data-plan='short'] {
		--tone: var(--sdp-short);
	}

	.sdp-plan-progress[data-plan='long'] {
		--tone: var(--sdp-long);
	}

	.ring {
		position: relative;
		flex: none;
		width: 4.4rem;
		height: 4.4rem;
	}

	.ring svg {
		width: 100%;
		height: 100%;
		transform: rotate(-90deg);
	}

	.ring circle {
		fill: none;
		stroke-width: 7;
	}

	.ring .track {
		stroke: var(--sdp-surface-2);
	}

	.ring .value {
		stroke: var(--tone);
		stroke-linecap: round;
		transition: stroke-dasharray 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	[data-complete] .ring .value {
		stroke: var(--sdp-success);
	}

	.ring span {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		font-size: var(--sl-text-sm);
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		color: var(--sl-color-white);
	}

	.info {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.info p {
		margin: 0;
		word-break: keep-all;
	}

	.label {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sdp-muted);
	}

	.status {
		font-weight: 650;
		color: var(--sl-color-white);
	}

	.next {
		font-size: var(--sl-text-sm);
		color: var(--sdp-muted);
	}

	.next[hidden] {
		display: none;
	}

	.next a {
		font-weight: 650;
		color: var(--tone);
	}

	.reset {
		align-self: flex-start;
		padding: 0.25rem 0.6rem;
		border-radius: 8px;
		border: 1px solid transparent;
		background: none;
		font: inherit;
		font-size: var(--sl-text-2xs);
		color: var(--sdp-muted);
		cursor: pointer;
	}

	.reset:hover {
		border-color: var(--sdp-border);
		color: var(--sl-color-white);
	}
</style>
